{
  "version": "2.0.0",
  "tasks": [
	{
		"type": "cppbuild",
		"label": "C/C++: clang++ (C++20) build active file",
		"command": "/usr/bin/clang++",
		"args": [
			"-fdiagnostics-color=always",
			"-std=c++20",
			"-Wall",
			"-Wextra",
			"-Wpedantic",
			"-O0",
			"-g",
			"${file}",
			"-o",
			"${fileDirname}/bin/${fileBasenameNoExtension}"
		],
		"options": {
			"cwd": "${fileDirname}"
		},
		"problemMatcher": [
			"$gcc"
		],
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"detail": "compiler: /usr/bin/clang++ (C++20)"
	}
]
}
